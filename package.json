{
  "name": "bubble-sheet",
  "version": "0.1.0",
  "description": "A headless answer-sheet (scantron) engine plus an optional DOM renderer. Framework-agnostic.",
  "keywords": [
    "scantron",
    "bubble-sheet",
    "answer-sheet",
    "omr",
    "quiz",
    "exam",
    "form",
    "headless"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./styles.css": "./dist/bubble-sheet.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "demo": "node scripts/serve.mjs",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:css",
    "clean": "rm -rf dist",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/finish-cjs.mjs",
    "build:css": "mkdir -p dist && cp src/bubble-sheet.css dist/bubble-sheet.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "test:fast": "node --test test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgaspari/bubble-sheet.git"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://mgaspari.github.io/bubble-sheet/",
  "bugs": {
    "url": "https://github.com/mgaspari/bubble-sheet/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
